# Copy to .env and fill in. .env is ignored by git.

# Required.
EXTRABADGES_ADMIN_TOKEN=change-me
# Token of a test bot from @BotFather; a real client's initData is signed with it.
EXTRABADGES_BOT_TOKEN=

# Optional.
# EXTRABADGES_CACHE_TTL=5m
# EXTRABADGES_CLIENT_TTL=720h
# EXTRABADGES_INITDATA_MAX_AGE=24h
# EXTRABADGES_MARK_EMOJI_ID=
# EXTRABADGES_MARK_TEXT=exteraless user
# Comma-separated CIDRs of reverse proxies whose X-Real-IP header is trusted.
# Host nginx in front of Docker connects from the bridge network:
# EXTRABADGES_TRUSTED_PROXIES=172.16.0.0/12
